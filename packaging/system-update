#!/usr/bin/env bash
set -uo pipefail

ID="linux-android-daemon"
TITLE="Linux Android Daemon"
STATE_FILE="${UPDATE_SOURCE_STATE:-/var/lib/$ID/source}"
SUPPORT="${LINUX_ANDROID_DAEMON_SUPPORT:-/usr/lib/$ID}"
source "$SUPPORT/lib.sh"

log() {
    printf '%s: %s\n' "$ID" "$*"
}

[[ -r $STATE_FILE ]] || exit 0
state_dir=$(dirname "$STATE_FILE")
failed_file="$state_dir/update-failed"
exec 9>"$state_dir/update.lock"
if ! flock -n 9; then
    log "another update is already running, skipping"
    exit 0
fi
mapfile -t state <"$STATE_FILE"
checkout="${state[0]:-}"
owner="${state[1]:-}"
[[ -n $checkout && -n $owner ]] || exit 0
uid=$(id -u "$owner" 2>/dev/null) || exit 0
home=$(getent passwd "$owner" | cut -d: -f6)

as_owner() {
    runuser -u "$owner" -- env -i HOME="$home" USER="$owner" LOGNAME="$owner" PATH="$home/.local/bin:/usr/local/bin:/usr/bin:/bin" \
        LANG="${LANG:-C.UTF-8}" XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        GIT_TERMINAL_PROMPT=0 GIT_ASKPASS= GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15" "$@"
}

git_owner() {
    as_owner git -C "$checkout" "$@"
}

if [[ ! -d $checkout ]]; then
    if [[ -d $home ]]; then
        log "$checkout is gone, removing $TITLE from system updates"
        remove_update_system_files
    else
        log "checkout $checkout is gone but $home is missing, skipping"
    fi
    exit 0
fi
git_owner rev-parse HEAD >/dev/null 2>&1 || {
    log "$checkout is not a usable git repository, skipping"
    exit 0
}

pulled=false
if ! git_owner rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    log "$checkout has no upstream branch, not pulling"
elif ! git_owner fetch --quiet; then
    log "could not fetch updates for $checkout, not pulling"
elif [[ $(git_owner rev-list --count 'HEAD..@{upstream}') -gt 0 ]]; then
    if [[ -n $(git_owner status --porcelain --untracked-files=no) ]]; then
        log "$checkout has local changes, not pulling"
    elif [[ $(git_owner rev-list --count '@{upstream}..HEAD') -gt 0 ]]; then
        log "$checkout has local commits that aren't upstream, not pulling"
    elif git_owner merge --ff-only --quiet '@{upstream}'; then
        git_owner submodule update --init --recursive --quiet
        log "updated to $(git_owner rev-parse --short HEAD)"
        pulled=true
    else
        log "could not fast-forward $checkout, not pulling"
    fi
fi

dependencies_file="$state_dir/dependencies"
fingerprint=$(update_dependency_fingerprint "$UPDATE_HOOK")
if ! $pulled && [[ $fingerprint == "$(cat "$dependencies_file" 2>/dev/null)" ]]; then
    exit 0
fi
$pulled || log "the packages $TITLE depends on changed, rebuilding"

inputs=$(printf '%s\n%s\n' "$(git_owner rev-parse HEAD)" "$fingerprint" | sha256sum | cut -d' ' -f1)
if [[ $(cat "$failed_file" 2>/dev/null) == "$inputs" ]]; then
    log "last update failed for these inputs, skipping; run ./install.sh to retry"
    exit 0
fi
status=0
LINUX_ANDROID_DAEMON_SOURCE="$checkout" LINUX_ANDROID_DAEMON_SUPPORT="$SUPPORT" "$SUPPORT/install" --system-update-root --owner "$owner" || status=1
if [[ -S /run/user/$uid/bus ]]; then
    as_owner LINUX_ANDROID_DAEMON_SOURCE="$checkout" LINUX_ANDROID_DAEMON_SUPPORT="$SUPPORT" "$SUPPORT/install" --system-update || status=1
else
    as_owner mkdir -p "$home/.local/state/$ID"
    as_owner touch "$home/.local/state/$ID/update-pending"
    log "$TITLE will finish updating at your next login"
fi
if [[ $status -ne 0 ]]; then
    printf '%s\n' "$inputs" >"$failed_file"
    log "the update failed, it will not be retried until the source or its packages change"
else
    rm -f "$failed_file"
    update_dependency_fingerprint "$UPDATE_HOOK" >"$dependencies_file"
fi
