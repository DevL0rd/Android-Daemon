[Unit]
Description=Finish the Linux Android Daemon update from the last system update
ConditionPathExists=%h/.local/state/linux-android-daemon/update-pending
After=graphical-session.target

[Service]
Type=oneshot
Environment=LINUX_ANDROID_DAEMON_SOURCE=@CHECKOUT@
Environment=LINUX_ANDROID_DAEMON_SUPPORT=@UPDATER_DIR@
ExecStart=@UPDATER_DIR@/install --system-update

[Install]
WantedBy=graphical-session.target
